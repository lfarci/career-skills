% career-resume.sty: reusable resume building blocks for build-resume.
% Standard packages only; works with pdfLaTeX, XeLaTeX (Tectonic) and LuaLaTeX.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{career-resume}[2026/10/29 Career Skills resume blocks]

\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
  \RequirePackage{lmodern}
\else
  \RequirePackage{fontspec}
\fi
\RequirePackage[a4paper,margin=1.4cm]{geometry}
\RequirePackage{xcolor}
\RequirePackage{enumitem}
\RequirePackage[hidelinks]{hyperref}

% Colours: override with \definecolor in the document after \usepackage.
\definecolor{ResumeInk}{HTML}{111827}
\definecolor{ResumeAccent}{HTML}{1D4ED8}
\definecolor{ResumeSoft}{HTML}{E8EEFC}
\definecolor{ResumeMuted}{HTML}{4B5563}

\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{2em}
\raggedright

% \resumeHeader{Name}{Headline}{contact line}
\newcommand{\resumeHeader}[3]{%
  {\color{ResumeInk}\fontsize{22}{26}\selectfont\bfseries #1\par}%
  \vspace{2pt}%
  {\color{ResumeAccent}\large #2\par}%
  \vspace{3pt}%
  {\color{ResumeMuted}\small #3\par}%
  \vspace{4pt}%
}

% \resumeSection{Title}: tinted heading bar
\newcommand{\resumeSection}[1]{%
  \par\addvspace{9pt}%
  {\setlength{\fboxsep}{3pt}\colorbox{ResumeSoft}{\makebox[\dimexpr\linewidth-2\fboxsep][l]{%
    \color{ResumeAccent}\bfseries\large #1}}}%
  \par\vspace{4pt}%
}

% \resumeEntry{Title}{Organization}{Dates}{Location}
\newcommand{\resumeEntry}[4]{%
  \par\addvspace{4pt}%
  \textbf{#1}\ifx\relax#2\relax\else\ {\color{ResumeMuted}· #2}\fi
  \hfill{\color{ResumeMuted}#3}\par
  \ifx\relax#4\relax\else{\color{ResumeMuted}\small #4\par}\fi
}

% Compact bullet list for entry details
\newenvironment{resumeItems}%
  {\begin{itemize}[leftmargin=1.3em,topsep=2pt,itemsep=1.5pt,parsep=0pt]}%
  {\end{itemize}}

% \resumeSkillLine{Label}{items}
\newcommand{\resumeSkillLine}[2]{\textbf{#1:} #2\par\vspace{1.5pt}}

% \resumeText{paragraph}
\newcommand{\resumeText}[1]{#1\par}

\AtBeginDocument{\color{ResumeInk}}
\endinput
